{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnyOCR",
  "version": "0.1.0",
  "identifier": "com.anyocr.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AnyOCR",
        "width": 1200,
        "height": 780,
        "minWidth": 920,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../vendor/pdfium/win-x64/pdfium.dll": "pdfium.dll"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxQkU3REE3MDhCM0JEODkKUldTSnZiTUlwMzIrc1VubFVmNWVoeFQ2S3B0N3BOQnBhbjJSZnZLSUl5TTVzUTgwaVFxMjBCb1UK",
      "endpoints": ["https://github.com/copylee711/anyocr/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
